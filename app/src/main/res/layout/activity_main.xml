<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    tools:context=".ui.MainActivity">

    <!-- RELEVANT NOTES SECTION -->
    <TextView
        android:id="@+id/relevantNotesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Relevant Notes"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <ListView
        android:id="@+id/relevantNotesList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="0.5dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <!-- ALL NOTES SECTION HEADER -->
    <TextView
        android:id="@+id/allNotesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All Notes"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"/>

    <!-- MAIN CONTENT AREA -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TAGS BUTTON -->
        <Button
            android:id="@+id/tagsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tags"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"/>

        <!-- MAP BUTTON -->
        <Button
            android:id="@+id/mapButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Note Map"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"/>

        <ListView
            android:id="@+id/notesList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/mapButton"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="0.5dp"
            android:padding="12dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="20dp"
            android:contentDescription="Add Note"
            android:src="@android:drawable/ic_input_add"
            android:backgroundTint="#F4C842"
            android:tint="#000" />

    </RelativeLayout>

</LinearLayout>