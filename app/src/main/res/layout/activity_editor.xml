<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:id="@+id/editorRootLayout">

    <!-- Header row: Cancel, Actions, Save -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#007AFF" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/locationButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:contentDescription="Set Location"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#007AFF" />

                <ImageButton
                    android:id="@+id/reminderButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:src="@android:drawable/ic_popup_reminder"
                    android:contentDescription="Set Reminder"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#007AFF" />

                <ImageButton
                    android:id="@+id/tagsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    android:contentDescription="Assign Tags"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#007AFF" />

                <ImageButton
                    android:id="@+id/pinButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:src="@android:drawable/star_off"
                    android:contentDescription="Pin Note"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#007AFF" />

                <ImageButton
                    android:id="@+id/templateButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:contentDescription="Templates"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#007AFF" />

            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="#007AFF" />
    </LinearLayout>

    <!-- Title -->
    <EditText
        android:id="@+id/titleEditText"
        android:hint="Title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:importantForAutofill="no"
        android:inputType="textCapSentences" />

    <!-- Status Displays -->
    <TextView
        android:id="@+id/reminderStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Time Reminder: Nov 5, 2025 at 8:00 PM"/>

    <TextView
        android:id="@+id/locationStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Location: University of Southern California"/>

    <LinearLayout
        android:id="@+id/tagsDisplayLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tags: "
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tagsDisplayTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            tools:text="CS310, Project, Important"/>
    </LinearLayout>

    <TextView
        android:id="@+id/templateStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Template: Meeting Notes"
        tools:visibility="visible"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"/>

    <!-- === Formatting Toolbar + Attachments === -->
    <LinearLayout
        android:id="@+id/formatToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <ImageButton
            android:id="@+id/boldButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_format_bold"
            android:contentDescription="Bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#007AFF" />

        <ImageButton
            android:id="@+id/italicButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_format_italic"
            android:contentDescription="Italic"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#007AFF" />

        <ImageButton
            android:id="@+id/checklistButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_checklist"
            android:contentDescription="Checklist"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#007AFF" />

        <ImageButton
            android:id="@+id/fontSizeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_text_size"
            android:contentDescription="Font size"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#007AFF" />

        <ImageButton
            android:id="@+id/highlightButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Highlight"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#007AFF" />

        <!-- New: Photo and Voice buttons -->
        <ImageButton
            android:id="@+id/photoButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Attach Photo"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#007AFF" />

        <ImageButton
            android:id="@+id/recordButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Record Voice Memo"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#007AFF" />

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Play Voice Memo"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#007AFF" />
    </LinearLayout>


    <!-- Main note body -->
    <EditText
        android:id="@+id/noteBodyEditText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inputType="textMultiLine|textCapSentences"
        android:gravity="top"
        android:hint="Start writing..."
        android:textSize="18sp"
        android:overScrollMode="always"
        android:importantForAutofill="no"
        android:background="@android:color/transparent" />

    <!-- Optional photo preview -->
    <ImageView
        android:id="@+id/photoPreview"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:visibility="visible"
        tools:src="@drawable/ic_menu_camera"/>

    <!-- Optional voice status -->
    <TextView
        android:id="@+id/voiceStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recording..."
        android:textColor="#FF5252"
        android:visibility="gone"
        android:gravity="center"
        android:paddingTop="4dp"/>
</LinearLayout>
