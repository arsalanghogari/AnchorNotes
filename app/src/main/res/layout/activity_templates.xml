<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/templatesAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.AnchorNotes.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/templatesToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/Theme.AnchorNotes.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <ListView
        android:id="@+id/templatesListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/templatesAppBar"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="0.5dp"
        android:padding="12dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/templatesEmptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No templates yet. Tap + to create one."
        android:textColor="@android:color/darker_gray"
        android:textAlignment="center"
        android:padding="24dp"
        android:layout_below="@id/templatesAppBar"
        android:layout_marginTop="48dp"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addTemplateButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add Template"
        app:tint="#000"
        android:backgroundTint="#F4C842" />

</RelativeLayout>

